{
  "openapi": "3.1.0",
  "info": {
    "title": "Quest App API",
    "description": "Get small real-life side quests and record whether you completed, skipped or abandoned them.",
    "version": "2.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health check",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/quests": {
      "post": {
        "summary": "Create a new quest",
        "operationId": "create_quest_quests_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional unique value; repeating a request with the same key will not create a second quest",
              "title": "Idempotency-Key"
            },
            "description": "Optional unique value; repeating a request with the same key will not create a second quest"
          }
        ],
        "responses": {
          "201": {
            "description": "Quest created (or, for a repeated Idempotency-Key, the quest that key already created)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quest"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Address of the quest, e.g. /quests/{instance_id}",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replayed": {
                "description": "\"true\" when this is a repeat of an earlier request with the same Idempotency-Key",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (bad ID, body or query value)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List quests",
        "operationId": "list_quests_quests_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "in_progress",
                    "completed",
                    "skipped",
                    "abandoned"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Quest"
                  },
                  "title": "Response List Quests Quests Get"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (bad ID, body or query value)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/quests/{instance_id}": {
      "get": {
        "summary": "Get one quest",
        "operationId": "get_quest_quests__instance_id__get",
        "parameters": [
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Instance Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quest"
                }
              }
            }
          },
          "404": {
            "description": "No quest with this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (bad ID, body or query value)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Resolve a quest (complete, skip or abandon)",
        "operationId": "update_quest_quests__instance_id__patch",
        "parameters": [
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Instance Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quest"
                }
              }
            }
          },
          "404": {
            "description": "No quest with this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Quest is already resolved with a different status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (bad ID, body or query value)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "problem": {
            "type": "string",
            "title": "Problem"
          }
        },
        "type": "object",
        "required": [
          "field",
          "problem"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "Quest": {
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid",
            "title": "Instance Id"
          },
          "quest_id": {
            "type": "integer",
            "title": "Quest Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "skipped",
              "abandoned"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "instance_id",
          "quest_id",
          "category",
          "difficulty",
          "text",
          "status",
          "created_at"
        ],
        "title": "Quest"
      },
      "QuestUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "skipped",
              "abandoned"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "QuestUpdate"
      }
    }
  }
}
